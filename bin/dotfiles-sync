#!/bin/bash
set -euo pipefail
REPO="$HOME/dotfiles"
cd "$REPO"

# a human (or a previous failed sync) is mid-rebase — stay out of the way
if [ -d .git/rebase-merge ] || [ -d .git/rebase-apply ]; then exit 0; fi

git add -A
if ! git diff --cached --quiet; then
  git commit -q -m "sync: $(hostname -s) $(date '+%Y-%m-%d %H:%M')"
fi

if ! git pull --rebase --autostash -q; then
  git rebase --abort 2>/dev/null || true
  msg="dotfiles sync hit a conflict — resolve by hand"
  case "$(uname)" in
    Darwin) osascript -e "display notification \"$msg\" with title \"dotfiles-sync\"" || true ;;
    Linux) command -v notify-send >/dev/null 2>&1 && notify-send "dotfiles-sync" "$msg" || true ;;
  esac
  echo "dotfiles-sync: $msg" >&2
  exit 1
fi

if [ -n "$(git log --oneline @{u}.. 2>/dev/null)" ]; then
  git push -q
fi
